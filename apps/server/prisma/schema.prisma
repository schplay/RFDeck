generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model InventoryDevice {
  id                 String   @id @default(uuid())
  name               String
  manufacturer       String
  model              String
  ip                 String
  port               Int
  location           String?
  notes              String?
  password           String?
  deviceType         String   @default("input")
  // Did a person set deviceType, or did RFDeck infer it when the device was
  // added?
  //
  // RFDeck guesses from the model and name at *add* time only, because the add
  // form defaults to "input" and a device added from the discovery list is
  // never asked at all — so IEM transmitters would arrive filed as microphones.
  //
  // Nothing re-runs that guess afterwards. An existing device's type is the
  // operator's, and rewriting it on a restart would mean a correction never
  // stuck. This flag records provenance so that any future automatic
  // classification cannot overrule a person either.
  deviceTypeManual   Boolean  @default(false)
  // Operator-controlled: inactive devices are intentionally powered off / not in
  // use for this show.  They are not tracked, not shown on the dashboard, and
  // never raise dropout or battery alerts.
  active             Boolean  @default(true)
  mac                String?
  serial             String?
  firmware           String?
  // Frequency coordination: which band this receiver is, and who said so.
  //
  // Axient Digital and EW-DX report their band over the protocol; ULX-D,
  // QLX-D and G3/G4 do not, so an operator declares it. "reported" always
  // wins over "declared" — the hardware is the truth about itself — and a
  // declared band is never overwritten by anything but a report or a person.
  // See docs/COORDINATION_PROFILES.md.
  band               String?
  bandSource         String?  // 'reported' | 'declared'
  // High Density / Link Density mode, as the receiver reports it.
  dense              Boolean  @default(false)
  // Digital 6000 publishes its own carrier limits instead of a band code.
  carrierMinKHz      Int?
  carrierMaxKHz      Int?
  carrierStepKHz     Int?
  addedAt            DateTime @default(now())

  maintenance        MaintenanceEntry[]
}

// What has been done to a piece of hardware, and when.
//
// The question this answers is "has this one been trouble before" — asked when
// a channel misbehaves and the operator is deciding whether to swap the pack or
// chase the RF. Answering it from memory across a season, a rental fleet, or a
// change of A2 does not work.
//
// Separate from the event log, which records what the *system* did. This
// records what a person did with a screwdriver.
model MaintenanceEntry {
  id        String   @id @default(uuid())
  deviceId  String
  device    InventoryDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  // When the work happened, which is not when it was written down — a repair
  // on Monday is often logged on Tuesday.
  at        DateTime @default(now())
  // BATTERY | ELEMENT | REPAIR | FIRMWARE | SERVICE | NOTE. A string rather
  // than an enum so SQLite and Postgres behave the same and adding a kind is
  // not a migration.
  kind      String   @default("NOTE")
  summary   String
  detail    String   @default("")
  // Set on entries RFDeck wrote itself, so an operator can tell a firmware
  // change it observed from one someone typed in.
  automatic Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([deviceId, at])
}

model Settings {
  id                 String   @id @default(uuid())
  aes67MulticastIp   String   @default("239.69.0.1")
  aes67Port          Int      @default(5004)
  batteryWarningPct  Int      @default(20)
  batteryCriticalPct Int      @default(5)
  dropoutSensitivity Int      @default(20)
  bindInterface      String   @default("0.0.0.0")
  defaultPassword    String?
  // ALSA device on the SERVER that monitoring captures from, e.g. "hw:1,0".
  // The interface is in the rack, so the device list is the server's, not a
  // browser's — see src/audio/deviceList.ts.
  audioInputDevice   String?

  // ── Remote access ──
  // Default is an open, trusted show network. When authPinEnabled is on,
  // non-loopback clients must present the PIN before receiving any data.
  authPinEnabled     Boolean  @default(false)
  authPinHash        String?
  // Hours before a remote client must re-enter the PIN. 0 = never re-prompt.
  authReauthHours    Int      @default(0)

  // ── Live ──
  //
  // The operator declaring that RFDeck is working the rig: every device
  // tracked, capture and fault detection running, the Micboard showing the
  // cast. Null means standing down — devices disabled, nothing recording.
  //
  // A single nullable pointer rather than a flag per show, so "two shows are
  // live at once" cannot be represented at all.
  liveStartedAt      DateTime?
  // Whose cast the Micboard shows. Optional: a rehearsal or a one-off goes
  // live with no show, and tiles fall back to channel names.
  liveShowId         String?

  // ── Rolling capture ──
  // On by default: a problem worth reviewing is one nobody predicted, so
  // recording that must be switched on first would be off when it mattered.
  recordingEnabled   Boolean  @default(true)
  // Ceiling for stored clips, in megabytes. Clips fill it FIFO; flagged clips
  // are never pruned automatically.
  recordingMaxMb     Int      @default(2048)
  // Seconds kept before and after a detection. The pre-roll is held in memory
  // per patched channel, so it is deliberately short.
  recordingPreSec    Int      @default(15)
  recordingPostSec   Int      @default(10)

  // ── Browser push ──
  // VAPID keys identify this server to push services. Generated once on first
  // use and kept, because every browser subscription is bound to the public
  // key: regenerating it would silently orphan every subscription.
  vapidPublicKey     String?
  vapidPrivateKey    String?
}

// ── Notifications that leave the browser ──
//
// An alert that only exists in an open tab tells nobody at 2am. A webhook is
// an HTTP POST to a URL the operator supplies — Slack, Teams, a home
// automation box, anything — and is the honest primitive: self-contained, no
// account, no bill. Browser push reaches a phone through the browser's own
// push service with the same properties.
//
// Both are free-tier per docs/EDITIONS.md. Email and SMS, which need a hosted
// service RFDeck operates on the customer's behalf, are cloud features and are
// not here.

model Webhook {
  id          String    @id @default(uuid())
  name        String
  url         String
  // Shared secret for an HMAC-SHA256 signature over the body, so a receiver
  // can verify the POST came from this server. Encrypted at rest like a
  // device password.
  secret      String?
  enabled     Boolean   @default(true)
  // INFO | WARNING | CRITICAL. Defaults to CRITICAL: a webhook that fires on
  // every channel mute is one an operator switches off within a night.
  minSeverity String    @default("CRITICAL")
  // What happened last time, so a webhook that is failing is visible rather
  // than silently not arriving.
  lastAt      DateTime?
  lastStatus  Int?
  lastError   String?
  failures    Int       @default(0)
  createdAt   DateTime  @default(now())
}

model PushSubscription {
  id          String    @id @default(uuid())
  // The push service URL. Unique: a browser re-subscribing replaces itself.
  endpoint    String    @unique
  // The subscription's own keys (p256dh, auth), as the browser gave them.
  keys        String
  minSeverity String    @default("CRITICAL")
  // Which browser this is, as far as its user agent says — so a list of
  // subscriptions is readable rather than a list of opaque URLs.
  label       String?
  lastAt      DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
}

// Something that looked like a wireless fault, with the audio that proves it.
//
// Distinct from Event: an Event is a log line, a Detection is an incident with
// a clip attached that an operator reviews, flags, or dismisses afterwards.
model Detection {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  // Stable channel id: the inventory row's uuid and the receiver slot. Never a
  // name — a channel relabelled on the hardware must not orphan the incidents
  // already filed against it.
  channelKey  String
  // What it was called at the time, for display in the history. A snapshot,
  // never a key.
  channelName String?
  deviceId    String?
  // What raised it: RF_DROPOUT for now; audio-signature triggers later.
  trigger     String
  severity    String   @default("WARNING")
  message     String
  rfLevelA    Int?
  rfLevelB    Int?
  // The show running at the time, for report scoping.
  showId      String?
  act         Int?
  // Filename within the clips directory. Null while the post-roll is still
  // being captured, or if writing failed.
  clipPath    String?
  clipBytes   Int      @default(0)
  clipMs      Int      @default(0)
  // Flagged by an operator: "this one matters". Exempt from FIFO pruning.
  flagged     Boolean  @default(false)
  note        String?
  dismissed   Boolean  @default(false)

  @@index([timestamp])
  @@index([channelKey])
  @@index([flagged])
}

// Which audio input each RF channel is patched to.
//
// Server-side because the patch describes the rack, not a viewer's preference —
// every client should see the same mapping. Any device, any input: nothing here
// assumes a channel count or a single interface.
model ChannelAudioMap {
  // Stable channel id: the inventory row's uuid and the receiver slot. RFDeck
  // owns the uuid and the slot is physical, so the patch survives a DHCP
  // reassignment, a rename on the hardware, and a rename of the row.
  channelKey   String @id
  // ALSA device on the server, e.g. "hw:1,0".
  deviceId     String
  // 1-based input on that device.
  inputChannel Int
}

// ── Show & mic check ──
// Shows may live indefinitely or be archived; archiving is a soft flag so the
// record and its history are always recoverable.

model Show {
  id              String    @id @default(uuid())
  name            String
  environmentMode String    @default("THEATER")
  date            String?
  venue           String?
  notes           String?
  currentAct      Int       @default(1)
  // How many acts, services, sets or segments this production runs to. Four was
  // hard-coded, which is a theatre assumption — a worship service is usually
  // one, a festival is however many bands are booked.
  periodCount     Int       @default(4)
  archived        Boolean   @default(false)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  players         Player[]
  micCheck        MicCheckEntry[]
}

// A person, independent of any show. The same performer is cast in many shows
// over a season, so they are a roster in their own right rather than a field
// on one show's cast list.
model Performer {
  id        String   @id @default(uuid())
  name      String
  notes     String   @default("")
  // How this person is rigged: where the element is taped, where the pack
  // sits, spare element, comfort and allergy notes. Belongs to the person
  // rather than the production — it is the same next season.
  fitNotes  String   @default("")
  // Filename within the images directory beside the database. A headshot, for
  // finding someone backstage you have not met.
  photoPath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  castings  Player[]
}

// One performer coming off mic and back on, within one show. Theatre business:
// a costume change that takes the pack off, and the cues either side of it.
model QuickChange {
  id        String @id @default(uuid())
  playerId  String
  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  act       Int?
  outCue    String @default("")
  inCue     String @default("")
  notes     String @default("")
  sortIndex Int    @default(0)

  @@index([playerId])
}

// One performer's place in one show: their role, channel and notes for THAT
// show. The name is the performer's, copied here so a casting still reads
// correctly if the performer is later removed from the roster; the server
// keeps the copy in step when a performer is renamed.
model Player {
  id                 String     @id @default(uuid())
  showId             String
  show               Show       @relation(fields: [showId], references: [id], onDelete: Cascade)
  performerId        String?
  performer          Performer? @relation(fields: [performerId], references: [id], onDelete: SetNull)
  realName           String
  characterName      String     @default("")
  notes              String     @default("")
  // Stable channel id: the inventory row's uuid and the receiver slot. A show
  // must survive a power cycle that moves receivers, and equally a channel
  // being relabelled at the rack — neither may cost a performer their mic
  // assignment.
  assignedChannelKey String?
  // The performer's IEM, on the same terms as the mic. Kept separate because
  // the soundcheck is about mics only; IEMs are assigned but not checked there.
  iemChannelKey      String?
  sortIndex          Int        @default(0)

  quickChanges       QuickChange[]

  @@index([showId])
  @@index([performerId])
}

// Timestamped history of what happened, persisted so it survives a restart and
// can back a post-show report. Both alerts and RF dropout/recovery land here.
model Event {
  id             String   @id @default(uuid())
  timestamp      DateTime @default(now())
  // ALERT | RF
  source         String
  // DROPOUT, RECOVERY, LOW_BATTERY, CRITICAL_BATTERY, MUTED, ...
  type           String
  // INFO | WARNING | CRITICAL
  severity       String   @default("INFO")
  message        String
  // Stable channel id: the inventory row's uuid and the receiver slot.
  channelKey     String?
  // What it was called at the time. A snapshot for display, never a key.
  channelName    String?
  deviceId       String?
  rfLevelA       Int?
  rfLevelB       Int?
  acknowledged   Boolean  @default(false)
  acknowledgedBy String?
  dismissed      Boolean  @default(false)

  @@index([timestamp])
  @@index([type])
}

model MicCheckEntry {
  id         String    @id @default(uuid())
  showId     String
  show       Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  act        Int
  channelKey String
  checked    Boolean   @default(false)
  checkedAt  DateTime?
  // Populated once operator identity exists; nullable so no second migration.
  checkedBy  String?
  notes      String?

  @@unique([showId, act, channelKey])
  @@index([showId])
}

