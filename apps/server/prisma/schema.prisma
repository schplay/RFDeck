generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model InventoryDevice {
  id                 String   @id @default(uuid())
  name               String
  manufacturer       String
  model              String
  ip                 String
  port               Int
  location           String?
  notes              String?
  password           String?
  deviceType         String   @default("input")
  // Operator-controlled: inactive devices are intentionally powered off / not in
  // use for this show.  They are not tracked, not shown on the dashboard, and
  // never raise dropout or battery alerts.
  active             Boolean  @default(true)
  mac                String?
  serial             String?
  firmware           String?
  // The name stored on the hardware itself (a G3's channel label). Recorded at
  // first connect and used to re-identify the device after an IP change even
  // when the operator has renamed the inventory row and no MAC is on record.
  hardwareLabel      String?
  addedAt            DateTime @default(now())
}

model Settings {
  id                 String   @id @default(uuid())
  aes67MulticastIp   String   @default("239.69.0.1")
  aes67Port          Int      @default(5004)
  batteryWarningPct  Int      @default(20)
  batteryCriticalPct Int      @default(5)
  dropoutSensitivity Int      @default(20)
  bindInterface      String   @default("0.0.0.0")
  defaultPassword    String?
  // ALSA device on the SERVER that monitoring captures from, e.g. "hw:1,0".
  // The interface is in the rack, so the device list is the server's, not a
  // browser's — see src/audio/deviceList.ts.
  audioInputDevice   String?

  // ── Remote access ──
  // Default is an open, trusted show network. When authPinEnabled is on,
  // non-loopback clients must present the PIN before receiving any data.
  authPinEnabled     Boolean  @default(false)
  authPinHash        String?
  // Hours before a remote client must re-enter the PIN. 0 = never re-prompt.
  authReauthHours    Int      @default(0)

  // ── Rolling capture ──
  // On by default: a problem worth reviewing is one nobody predicted, so
  // recording that must be switched on first would be off when it mattered.
  recordingEnabled   Boolean  @default(true)
  // Ceiling for stored clips, in megabytes. Clips fill it FIFO; flagged clips
  // are never pruned automatically.
  recordingMaxMb     Int      @default(2048)
  // Seconds kept before and after a detection. The pre-roll is held in memory
  // per patched channel, so it is deliberately short.
  recordingPreSec    Int      @default(15)
  recordingPostSec   Int      @default(10)
}

// Something that looked like a wireless fault, with the audio that proves it.
//
// Distinct from Event: an Event is a log line, a Detection is an incident with
// a clip attached that an operator reviews, flags, or dismisses afterwards.
model Detection {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  // Channel NAME — survives a device IP change, as everywhere else.
  channelKey  String
  channelName String?
  deviceId    String?
  // What raised it: RF_DROPOUT for now; audio-signature triggers later.
  trigger     String
  severity    String   @default("WARNING")
  message     String
  rfLevelA    Int?
  rfLevelB    Int?
  // The show running at the time, for report scoping.
  showId      String?
  act         Int?
  // Filename within the clips directory. Null while the post-roll is still
  // being captured, or if writing failed.
  clipPath    String?
  clipBytes   Int      @default(0)
  clipMs      Int      @default(0)
  // Flagged by an operator: "this one matters". Exempt from FIFO pruning.
  flagged     Boolean  @default(false)
  note        String?
  dismissed   Boolean  @default(false)

  @@index([timestamp])
  @@index([channelKey])
  @@index([flagged])
}

// Which audio input each RF channel is patched to.
//
// Server-side because the patch describes the rack, not a viewer's preference —
// every client should see the same mapping. Any device, any input: nothing here
// assumes a channel count or a single interface.
model ChannelAudioMap {
  // Channel NAME, matching the rest of the app — ids embed the device IP and
  // would break on DHCP reassignment.
  channelKey   String @id
  // ALSA device on the server, e.g. "hw:1,0".
  deviceId     String
  // 1-based input on that device.
  inputChannel Int
}

// ── Show & mic check ──
// Shows may live indefinitely or be archived; archiving is a soft flag so the
// record and its history are always recoverable.

model Show {
  id              String    @id @default(uuid())
  name            String
  environmentMode String    @default("THEATER")
  date            String?
  venue           String?
  notes           String?
  currentAct      Int       @default(1)
  archived        Boolean   @default(false)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  players         Player[]
  micCheck        MicCheckEntry[]
}

// A person, independent of any show. The same performer is cast in many shows
// over a season, so they are a roster in their own right rather than a field
// on one show's cast list.
model Performer {
  id        String   @id @default(uuid())
  name      String
  notes     String   @default("")
  // How this person is rigged: where the element is taped, where the pack
  // sits, spare element, comfort and allergy notes. Belongs to the person
  // rather than the production — it is the same next season.
  fitNotes  String   @default("")
  // Filename within the images directory beside the database. A headshot, for
  // finding someone backstage you have not met.
  photoPath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  castings  Player[]
}

// One performer coming off mic and back on, within one show. Theatre business:
// a costume change that takes the pack off, and the cues either side of it.
model QuickChange {
  id        String @id @default(uuid())
  playerId  String
  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  act       Int?
  outCue    String @default("")
  inCue     String @default("")
  notes     String @default("")
  sortIndex Int    @default(0)

  @@index([playerId])
}

// One performer's place in one show: their role, channel and notes for THAT
// show. The name is the performer's, copied here so a casting still reads
// correctly if the performer is later removed from the roster; the server
// keeps the copy in step when a performer is renamed.
model Player {
  id                 String     @id @default(uuid())
  showId             String
  show               Show       @relation(fields: [showId], references: [id], onDelete: Cascade)
  performerId        String?
  performer          Performer? @relation(fields: [performerId], references: [id], onDelete: SetNull)
  realName           String
  characterName      String     @default("")
  notes              String     @default("")
  // Channel NAME, not channel id — ids embed the device IP, which changes on
  // DHCP reassignment. A show must survive a power cycle that moves receivers.
  assignedChannelKey String?
  // The performer's IEM, by channel name, on the same terms as the mic. Kept
  // separate because the soundcheck is about mics only; IEMs are assigned
  // but not checked there.
  iemChannelKey      String?
  sortIndex          Int        @default(0)

  quickChanges       QuickChange[]

  @@index([showId])
  @@index([performerId])
}

// Timestamped history of what happened, persisted so it survives a restart and
// can back a post-show report. Both alerts and RF dropout/recovery land here.
model Event {
  id             String   @id @default(uuid())
  timestamp      DateTime @default(now())
  // ALERT | RF
  source         String
  // DROPOUT, RECOVERY, LOW_BATTERY, CRITICAL_BATTERY, MUTED, ...
  type           String
  // INFO | WARNING | CRITICAL
  severity       String   @default("INFO")
  message        String
  // Channel NAME — survives a device IP change, unlike the channel id.
  channelKey     String?
  channelName    String?
  deviceId       String?
  rfLevelA       Int?
  rfLevelB       Int?
  acknowledged   Boolean  @default(false)
  acknowledgedBy String?
  dismissed      Boolean  @default(false)

  @@index([timestamp])
  @@index([type])
}

model MicCheckEntry {
  id         String    @id @default(uuid())
  showId     String
  show       Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  act        Int
  channelKey String
  checked    Boolean   @default(false)
  checkedAt  DateTime?
  // Populated once operator identity exists; nullable so no second migration.
  checkedBy  String?
  notes      String?

  @@unique([showId, act, channelKey])
  @@index([showId])
}

