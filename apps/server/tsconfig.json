{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "CommonJS",
    "moduleResolution": "Node"
  },
  "include": ["src/**/*"],
  // Tests run through Vitest, which does its own transform — keep them out of
  // the shipped build.
  "exclude": ["src/**/*.test.ts"]
}
