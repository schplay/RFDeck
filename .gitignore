# Encryption key for device passwords — never commit
.rfdeck-key
**/.rfdeck-key

# Desktop packaging staging artefacts (regenerated by pnpm package)
apps/desktop/resources/template.db
apps/desktop/resources/prisma-client/

# Local ssh-agent socket details — machine-specific, never useful in the repo.
# Matched anywhere: the rule used to name scripts/ only, and the file is
# written to the repository root, so it was committed despite the intent.
ssh-agent-vars

# Recorded incident clips (rolling capture)
clips/
*.wav

# Performer headshots
images/

# Playwright
test-results/
playwright-report/

# The development database.
#
# It holds whoever is working on RFDeck: their inventory, shows, performers and
# maintenance history. The desktop packaging script already strips it from
# builds for exactly that reason — "a privacy problem as much as a correctness
# one" — so it has no business in the repository either.
#
# Create one on a fresh clone with:  pnpm --filter @rfdeck/server prisma:push
apps/server/prisma/*.db
apps/server/prisma/*.db-journal
apps/server/prisma/*.db-wal
apps/server/prisma/*.db-shm

# TypeScript incremental build cache — regenerated by every typecheck.
*.tsbuildinfo

# Stray dev databases created by test runs
rfdeck.db
apps/server/rfdeck.db
