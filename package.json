{
  "name": "rfdeck",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev:server": "pnpm --filter @rfdeck/server dev",
    "dev:desktop": "pnpm --filter @rfdeck/desktop dev",
    "dev:web": "pnpm --filter @rfdeck/web dev",
    "build:server": "pnpm --filter @rfdeck/server build",
    "build:desktop": "pnpm --filter @rfdeck/desktop build",
    "build:web": "pnpm --filter @rfdeck/web build",
    "build:all": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @rfdeck/shared-types build && pnpm --filter @rfdeck/server build && pnpm --filter @rfdeck/web build && playwright test",
    "test:e2e:only": "playwright test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "@playwright/test": "^1.50.0"
  }
}
