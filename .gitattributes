# Shell scripts must keep LF endings regardless of the platform they are
# committed from. A CRLF checkout makes the shebang `#!/usr/bin/env bash\r`,
# which Linux reports as "bad interpreter: No such file or directory" — a
# confusing failure for something as visible as the installer.
*.sh text eol=lf

# Same reasoning: systemd units and Dockerfiles are read by Linux tooling.
*.service text eol=lf
Dockerfile  text eol=lf

# Windows-side tooling stays CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Let git decide for source, and never touch binaries.
*.ts   text
*.tsx  text
*.js   text
*.json text
*.md   text
*.db   binary
*.node binary
*.exe  binary
